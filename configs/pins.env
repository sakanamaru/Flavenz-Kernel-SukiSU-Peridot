# patches/susfs/. The 50_add patch below was rebased to apply with ZERO fuzz
# against ACK 0c3d559 ($ git apply --check passes exactly).
SUSFS_VERSION="v2.3.0"
SUSFS_UPSTREAM_REPO="https://github.com/ShirkNeko/susfs4ksu"
SUSFS_UPSTREAM_COMMIT="05f201978bdbd5d08f842e0a2a6e0f2ff0912787"
