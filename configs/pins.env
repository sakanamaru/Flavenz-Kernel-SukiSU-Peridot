# =============================================================================
# configs/pins.env — PINNED BUILD INPUTS for the peridot kernel CI
#
# SINGLE SOURCE OF TRUTH for every external input of
# .github/workflows/build-droidspaces.yml. The workflow loads this file and
# verifies each value before use; the release provenance is generated from it.
#
# Rules for editing:
#   * never use a branch/tag as a build input — pin the commit SHA;
#   * every downloaded file must have a sha256 here;
#   * changing any hash here is a supply-chain change: mention it in CHANGELOG;
#   * keep it POSIX-sh sourceable (`set -a; . configs/pins.env; set +a`).
# =============================================================================

# --- Android Common Kernel (ACK) 6.1 LTS ------------------------------------
ACK_REPO_URL="https://android.googlesource.com/kernel/common"
ACK_COMMIT="0c3d559bcd85c64dae9c9c9687abbe5347fff3ad"
ACK_DESCRIPTION="android14-6.1-lts @ 0c3d559 = 6.1.138-android14-11"

# --- peridot defconfig (Mohithash/kernel_xiaomi_sm8635, branch 17) -----------
# Pinned to the branch-17 commit that the boot-verified builds used. A branch
# name is intentionally NOT accepted by the workflow (branch HEAD moves).
DEFCONFIG_REPO_URL="https://github.com/Mohithash/kernel_xiaomi_sm8635.git"
DEFCONFIG_BRANCH_HINT="17"
DEFCONFIG_COMMIT="690024ef343deb44b03fa8e83dea5d5312c27795"
DEFCONFIG_GKI_SHA256="0d141b73f3f900bb62486caf75b3962d8c3a20d91a83308c87b52914f66395f0"
DEFCONFIG_VENDOR_SHA256="eff4b3bbb1f07ac097b523442e2c7cfc5d4cef64ac4b499838427f8984ddb7c6"
DEFCONFIG_EXRAWARN_SHA256="33cf065fd1bb5a2880772f8ae0175fdad952e512d2992b649efb88f970f9b94b"

# --- SukiSU-Ultra builtin branch --------------------------------------------
SUKISU_REPO_URL="https://github.com/SukiSU-Ultra/SukiSU-Ultra"
SUKISU_COMMIT="1cfa57340590971cba7521ed536da8ebbedc5f0a"
SUKISU_VERSION="builtin-1cfa573"
