SUSFS_DEF_HEADER_SHA256="cb441cb566d009bce20c1f4ce43fa10ce3472daafd0f37e144cdf1be87b3f88e"
SUSFS_PATCH="patches/susfs/50_add_susfs_in_gki-android14-6.1-ack-0c3d559.patch"
